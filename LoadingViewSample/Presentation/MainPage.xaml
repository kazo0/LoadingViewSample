<Page x:Class="LoadingViewSample.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:LoadingViewSample.Presentation"
      xmlns:models="using:LoadingViewSample.Models"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <Page.Resources>
    <Style x:Key="SectionCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      <Setter Property="Margin" Value="0,4,0,12" />
    </Style>

    <DataTemplate x:Key="ForecastTemplate" x:DataType="models:WeatherForecast">
      <Grid ColumnDefinitions="100,70,*" Padding="0,6">
        <TextBlock Grid.Column="0" Text="{Binding Day}" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="{Binding Temperature}" />
        <TextBlock Grid.Column="2" Text="{Binding Summary}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds" RowDefinitions="Auto,*">

    <!-- Extra top padding keeps the title clear of the Uno dev-tools overlay in DEBUG builds. -->
    <StackPanel Grid.Row="0" Padding="24,48,24,8">
      <TextBlock Text="Toolkit Tuesdays: LoadingView" FontSize="28" FontWeight="Bold" />
      <TextBlock Style="{StaticResource SectionCaptionStyle}"
                 Text="Three demos from the post, driven entirely by MVUX commands. Every Source below is an IAsyncCommand, which already implements ILoadable." />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="24,0,24,24" Spacing="24" MaxWidth="760" HorizontalAlignment="Left">

        <!-- ==========================================================
             1. Basic usage + a busy-aware command.
             FetchWeatherForecasts is a public method on MainModel. MVUX
             turns it into an IAsyncCommand, and because IAsyncCommand
             derives from ILoadable, the very same binding drives both
             the Button and the LoadingView.
             ========================================================== -->
        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="1. Basic usage + busy-aware command" />
            <TextBlock Style="{StaticResource SectionCaptionStyle}"
                       Text="Refresh takes 1.5s. The same generated command is bound to both the Button and the LoadingView's Source, so the button disables itself while the spinner is up." />

            <utu:LoadingView x:Name="BasicLoadingView" Source="{Binding FetchWeatherForecasts}" Height="330">
              <!-- The default child is the LoadingView's Content. -->
              <Grid RowDefinitions="Auto,*">
                <Button Grid.Row="0"
                        Content="Refresh"
                        Margin="0,0,0,8"
                        Command="{Binding FetchWeatherForecasts}" />
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Forecasts}"
                          ItemTemplate="{StaticResource ForecastTemplate}"
                          SelectionMode="None" />
              </Grid>

              <utu:LoadingView.LoadingContent>
                <ProgressRing IsActive="True" Width="48" Height="48" />
              </utu:LoadingView.LoadingContent>
            </utu:LoadingView>
          </StackPanel>
        </Border>

        <!-- ==========================================================
             2. Waiting on multiple sources.
             CompositeLoadableSource reports IsExecuting when ANY nested
             source is, so the spinner stays up until the SLOWEST call
             (3000ms) finishes — not the fastest (800ms).
             ========================================================== -->
        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="2. Waiting on multiple sources" />
            <TextBlock Style="{StaticResource SectionCaptionStyle}"
                       Text="Two independent commands (800ms and 3000ms). The spinner stays up until both are back, then everything appears together." />

            <utu:LoadingView Height="330">
              <utu:LoadingView.Source>
                <utu:CompositeLoadableSource>
                  <utu:LoadableSource Source="{Binding LoadFastContent}" />
                  <utu:LoadableSource Source="{Binding LoadSlowContent}" />
                </utu:CompositeLoadableSource>
              </utu:LoadingView.Source>

              <Grid RowDefinitions="Auto,*,*">
                <Button Grid.Row="0"
                        Content="Reload both"
                        Margin="0,0,0,8"
                        Click="OnReloadBoth" />
                <ListView Grid.Row="1" ItemsSource="{Binding FastResults}" SelectionMode="None" />
                <ListView Grid.Row="2" ItemsSource="{Binding SlowResults}" SelectionMode="None" />
              </Grid>

              <utu:LoadingView.LoadingContent>
                <!-- Note: no IsActive="True" here on purpose. The LoadingView template toggles
                     the utu:ProgressExtensions.IsActive attached property on its LoadingContent
                     as it moves between states, so this ring still spins. -->
                <ProgressRing Width="48" Height="48" />
              </utu:LoadingView.LoadingContent>
            </utu:LoadingView>
          </StackPanel>
        </Border>

        <!-- ==========================================================
             3. The gotcha.
             UpdateVisualState() resolves the target state with
             `Source?.IsExecuting ?? true`, so a null Source means
             Loading — forever. Watch the debug output for the
             5-second warning the Toolkit logs.
             ========================================================== -->
        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="3. The gotcha: a null Source spins forever" />
            <TextBlock Style="{StaticResource SectionCaptionStyle}"
                       Text="This LoadingView has no Source. It sits in its Loading state indefinitely and its Content never fades in. After 5 seconds the Toolkit logs a debug warning telling you exactly that. Click the button to hand it a real ILoadable and watch it recover." />

            <Button Content="Set the Source" Margin="0,0,0,8" Click="OnFixStuckSource" />

            <utu:LoadingView x:Name="StuckLoadingView" Height="120">
              <TextBlock Text="You'll only see me once Source is set."
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

              <utu:LoadingView.LoadingContent>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                  <ProgressRing IsActive="True" Width="40" Height="40" />
                  <TextBlock Text="Stuck..." HorizontalAlignment="Center" />
                </StackPanel>
              </utu:LoadingView.LoadingContent>
            </utu:LoadingView>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
